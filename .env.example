# =============================================================================
# Nautiq — variables de entorno (plantilla). Copia a .env y rellena los valores.
# El .env real NUNCA se commitea (.gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# 0) Entorno (DEV / PRE / PRO)
#    Determina el prefijo de los topics de Kafka de la sección 2 cuando no se fija
#    uno explícito con KAFKA_TOPIC_*: "<prefijo>-vessel-*-raw" en minúsculas
#    (DEV -> dev-, PRE -> pre-, PRO -> prod-). PRO es la única excepción al nombre
#    del entorno en minúsculas: los topics ya existentes en Aiven usan "prod-", no
#    "pro-". Cambiar esta variable cambia a qué entorno apunta el servicio sin
#    tocar ninguna otra.
#
#    En el ORÁCULO (api/, ver app/config.py) decide además los dos destinos de
#    cada recomendación — sin tocar código:
#      DEV -> tabla public.oracle_recommendations_dev      + carpeta ADLS "dev/"
#      PRO -> tabla public.oracle_recommendations_prod + carpeta ADLS "prod/"
#    El oráculo solo admite DEV y PRO (no tiene entorno de preproducción).
# -----------------------------------------------------------------------------
NAUTIQ_ENV="DEV"

# -----------------------------------------------------------------------------
# 1) AISStream (WebSocket de telemetría AIS)
#    Genera tu API key en: https://aisstream.io → Account → API Keys
#    AISStream admite UNA conexión por key. La principal sirve ShipStaticData
#    (descubrimiento continuo de la flota); la auxiliar es OPCIONAL y dedica una
#    conexión propia al firehose de PositionReport. Sin ella, ambos tipos
#    comparten conexión (sigue funcionando, con menos aislamiento de fallos).
# -----------------------------------------------------------------------------
AISSTREAM_API_KEY="<tu-api-key>"
AISSTREAM_AUX_API_KEY="<tu-segunda-api-key-opcional>"

#    TEMPORAL: si AISStream no sirve datos (ver aisstream/issues#257), pon
#    AIS_SYNTHETIC=true para generar tráfico simulado y no depender de las keys
#    de arriba. Quitar (o poner "false") en cuanto AISStream se recupere.
AIS_SYNTHETIC="false"

# -----------------------------------------------------------------------------
# 2) Kafka (Aiven, SSL)
#    Aiven Console → Kafka service → "Connection information"
#    Descarga los certificados SSL y ponlos en .certs/
# -----------------------------------------------------------------------------
KAFKA_BROKER_URL="<host>:<puerto>"
KAFKA_SSL_CA_LOCATION="./.certs/ca.pem"
KAFKA_SSL_CERT_LOCATION="./.certs/service.cert"
KAFKA_SSL_KEY_LOCATION="./.certs/service.key"

# Topics (OPCIONALES): por defecto se derivan de NAUTIQ_ENV (sección 0). Fíjalos
# aquí solo si necesitas un nombre que no siga el patrón "<entorno>-vessel-*-raw".
# KAFKA_TOPIC_POSITIONS="dev-vessel-positions-raw"
# KAFKA_TOPIC_STATIC="dev-vessel-static-raw"
# KAFKA_TOPIC_DLQ="dev-vessel-contracts-dlq"

# -----------------------------------------------------------------------------
# 3) Schema Registry — Aiven (Karapace)
#    Aiven Console → Kafka service → "Schema Registry" / Connection information
#    Servicio APARTE del broker (otro puerto). Auth básica: avnadmin:<password>
# -----------------------------------------------------------------------------
KAFKA_SCHEMA_REGISTRY_URL="https://<host>:<puerto>"
KAFKA_SCHEMA_REGISTRY_AUTH="avnadmin:<password>"

# -----------------------------------------------------------------------------
# 4) PostgreSQL (Supabase) — psycopg con variables discretas
#    Supabase Dashboard → Connect → "Session pooler"
#
#    USA EL SESSION POOLER, no la conexión directa. La directa
#    (db.<project-ref>.supabase.co) solo tiene registro AAAA: es IPv6-only, y
#    Azure Functions/App Service no tiene salida IPv6 — falla con "Cannot
#    assign requested address". El pooler resuelve por IPv4 y hace de puente.
#    En local, además, evita depender de que la red tenga IPv6 funcional.
#
#    Session (5432) y NO transaction (6543): psycopg3 activa prepared
#    statements del lado del servidor al repetir consultas, y el pooling en
#    modo transacción los rompe (cada transacción puede caer en otra conexión).
#    El transaction pooler tampoco soporta DDL.
#
#    OJO al usuario: en el pooler lleva el project-ref pegado
#    (postgres.<project-ref>), que es como enruta al proyecto correcto.
# -----------------------------------------------------------------------------
PGHOST="aws-<n>-<region>.pooler.supabase.com"
PGPORT="5432"
PGDATABASE="postgres"
PGUSER="postgres.<project-ref>"
PGPASSWORD="<password>"
PGSSLMODE="require"

# -----------------------------------------------------------------------------
# 5) ADLS Gen2 — copia analítica de las recomendaciones (Databricks)
# -----------------------------------------------------------------------------
ADLS_SAS_TOKEN=

# -----------------------------------------------------------------------------
# 6) Gemini GenAI Free tier Endpoint
#    https://aistudio.google.com/api-keys
#    Proveedor PRIMARIO del resumen en lenguaje natural del oráculo.
#
#    La key y el modelo van JUNTOS y cambian por entorno (DEV y PRO usan cuentas
#    de Google distintas, cada una con su cuota del free tier): no se derivan de
#    NAUTIQ_ENV en el código, se ponen los valores del entorno en cuestión aquí
#    (local) o en las Application Settings de la Azure Function (desplegado).
#
#    GEMINI_MODEL admite el id PELADO que espera el SDK google-genai
#    ("gemini-3.5-flash-lite"). NO uses el prefijo de proveedor estilo LiteLLM
#    ("gemini/gemini-3.5-flash-lite"): da 404 de modelo no encontrado.
#    Si se deja vacío, el código usa "gemini-3.5-flash-lite".
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=

# -----------------------------------------------------------------------------
# 7) Azure AI Foundry — respaldo del resumen LLM (de pago)
#    Azure AI Foundry portal -> tu proyecto -> Overview -> "Azure AI services"
#    endpoint + key.
#
#    OJO con el endpoint: tiene que ser el de INFERENCIA, terminado en /models
#    (https://<recurso>.services.ai.azure.com/models). El portal muestra de
#    forma prominente el del PROYECTO (.../api/projects/<proyecto>), que es
#    para el SDK azure-ai-projects y aquí falla con un "(BadRequest) API
#    version not supported" que no tiene nada que ver con la versión de API.
#
#    Solo se invoca cuando Gemini falla. Si tampoco responde, el oráculo cae al resumen
#    determinista sin LLM y lo marca con rationale_degradado=true en el evento.
#    Dejar en blanco para no usar respaldo (Gemini -> resumen determinista).
# -----------------------------------------------------------------------------
FOUNDRY_ENDPOINT=
FOUNDRY_API_KEY=
FOUNDRY_MODEL="gpt-4.1-mini"
