# =============================================================================
# Frontal — variables de BUILD. Vite las inlinea en el bundle, así que TODO lo que
# se ponga aquí acaba siendo público. Las credenciales PG* del oráculo NUNCA van aquí.
# =============================================================================

# -----------------------------------------------------------------------------
# 1) Entorno
#    Espejo de api/app/config.py: DEV | PRO. Solo esos dos — el oráculo no tiene entorno de
#    preproducción propio, así que la tabla de PRE no existe.
#    Decide la chapa de la cabecera y la tabla que se lee:
#        DEV -> oracle_recommendations_dev
#        PRO -> oracle_recommendations_prod
#    El entorno va como SUFIJO, y PRO es "prod" (no "pro"), igual que los topics de Kafka.
# -----------------------------------------------------------------------------
VITE_NAUTIQ_ENV="DEV"

# -----------------------------------------------------------------------------
# 2) Tabla de recomendaciones (OPCIONAL)
#    Solo si hay que corregir el nombre sin volver a desplegar. Mismo papel y mismo patrón
#    de validación que ORACLE_RECOMMENDATIONS_TABLE en el oráculo.
#
#    Las dos tablas están en el MISMO proyecto de Supabase, así que ambos despliegues
#    comparten URL y anon key: lo único que los diferencia es VITE_NAUTIQ_ENV.
#    `ports` y `thetis_mrv` son de referencia, compartidas, y el frontal no las lee.
# -----------------------------------------------------------------------------
# VITE_ORACLE_RECOMMENDATIONS_TABLE="oracle_recommendations_dev"

# -----------------------------------------------------------------------------
# 3) Supabase
#    La anon key es PÚBLICA por diseño: lo que protege la base es la RLS de la tabla
#    (SELECT para anon, sin policy de escritura), no el secreto de la clave.
#    Sin estas dos variables el frontal arranca con el fixture y lo anuncia en la cabecera.
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_ANON_KEY="<anon-key>"

# -----------------------------------------------------------------------------
# 4) Fixture
#    Fuerza los datos de ejemplo aunque haya credenciales. Útil para desarrollar sin red.
# -----------------------------------------------------------------------------
# VITE_USE_MOCK="true"
