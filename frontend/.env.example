# Frontal — variables de BUILD (Vite las inlinea en el bundle).
# La anon key es PUBLICA por diseno: lo que protege la base es la RLS de
# oracle_recommendations (SELECT para anon, sin policy de escritura), no el
# secreto de la clave. Las credenciales PG* del oraculo NUNCA van aqui.
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_ANON_KEY="<anon-key>"

# true  -> lee src/mock/events.json (desarrollo sin red, banner visible en la UI)
# false -> lee la tabla oracle_recommendations
VITE_USE_MOCK="true"
