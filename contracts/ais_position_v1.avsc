{
  "type": "record",
  "namespace": "io.nautiq.ais",
  "name": "Position",
  "doc": "Contrato v1 del topic 'vessel.positions.raw' (AIS PositionReport validado). El ULID de linaje viaja en los headers de Kafka, no en el payload. Fuente de verdad para Schema Registry (Avro).",
  "fields": [
    { "name": "mmsi", "type": "long", "doc": "Maritime Mobile Service Identity (partition key)." },
    { "name": "timestamp", "type": "string", "doc": "Instante del reporte en ISO-8601 UTC." },
    { "name": "lat", "type": "double", "doc": "Latitud [-90, 90]." },
    { "name": "lon", "type": "double", "doc": "Longitud [-180, 180]." },
    { "name": "speed", "type": "double", "doc": "Speed Over Ground en nudos (>= 0)." },
    { "name": "cog", "type": ["null", "double"], "default": null, "doc": "Course Over Ground en grados." },
    { "name": "heading", "type": ["null", "int"], "default": null, "doc": "True heading en grados." },
    { "name": "nav_status", "type": ["null", "int"], "default": null, "doc": "Navigational status AIS." },
    { "name": "_ingested_at", "type": "string", "default": "", "doc": "Metadato interno (prefijo '_'): instante UTC ISO-8601 en que el pipeline de ingestion validó el mensaje. No forma parte del payload AIS original." }
  ]
}
